% icmlstub.sty — ICML 체재의 최소 재현본.
%
% 주의: 이것은 공식 icml2025.sty 가 아니다. 공식 스타일은 CTAN 에 없고
% ICML 홈페이지의 저자 키트로만 배포되므로, 이 문서가 그 파일 없이도
% 컴파일되도록 체재(2단, 10pt, 레터, 제목/저자/초록 블록, 저자 매크로)를
% 재현한 것이다. 실제 투고 시에는 공식 스타일로 교체하고
% \usepackage{icmlstub} 를 \usepackage{icml2025} 로 바꾸면 된다.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icmlstub}[2026/10/04 ICML-like layout stub]

\RequirePackage{times}
\RequirePackage{fancyhdr}
\RequirePackage{color}
\RequirePackage{etoolbox}

\DeclareOption{accepted}{\@icmlacceptedtrue}
\newif\if@icmlaccepted \@icmlacceptedfalse
\ProcessOptions\relax

% ---- 지면 ----------------------------------------------------------------
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\setlength{\textwidth}{6.75in}
\setlength{\textheight}{9.0in}
\setlength{\columnsep}{0.25in}
\setlength{\oddsidemargin}{-0.125in}
\setlength{\evensidemargin}{-0.125in}
\setlength{\topmargin}{-0.5in}
\setlength{\headheight}{12pt}
\setlength{\headsep}{0.25in}
\setlength{\footskip}{0.3in}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}

% ---- 제목 블록 -----------------------------------------------------------
\newcommand{\icmltitle}[1]{%
  \begin{center}
    \vskip 0.10in
    {\LARGE\bfseries #1\par}
    \vskip 0.10in
  \end{center}}

\newenvironment{icmlauthorlist}{\begin{center}\large}{\end{center}}
\newcommand{\icmlauthor}[2]{#1\quad}
\newcommand{\icmlaffiliation}[2]{}
\newcommand{\icmlcorrespondingauthor}[2]{}
\newcommand{\icmlkeywords}[1]{}
\newcommand{\icmlEqualContribution}{}
\newcommand{\icmlsetsymbol}[2]{}
\newcommand{\printAffiliationsAndNotice}[1]{%
  \begingroup\footnotesize\begin{center}#1\end{center}\endgroup\vskip 0.1in}
\newcommand{\icmlEqualContributionNotice}{}

% ---- 초록 ----------------------------------------------------------------
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.6ex}%
  \begin{quote}\small}{\end{quote}\vspace{0.4ex}}

% ---- 머리말 --------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\itshape \@icmlrunningtitle}
\fancyfoot[C]{\thepage}
\def\@icmlrunningtitle{}
\newcommand{\icmltitlerunning}[1]{\gdef\@icmlrunningtitle{#1}}

% ---- 절 제목 -------------------------------------------------------------
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-0.12in \@plus -1ex \@minus -.2ex}{0.06in \@plus.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-0.10in \@plus -1ex \@minus -.2ex}{0.04in \@plus.2ex}%
  {\normalfont\normalsize\bfseries}}
\endinput
